{
  "name": "@stanley2058/hmd",
  "version": "0.1.2",
  "description": "A dynamic, agent-friendly HackMD CLI",
  "keywords": [
    "agents",
    "cli",
    "hackmd",
    "markdown",
    "openapi"
  ],
  "homepage": "https://github.com/stanley2058/hmd#readme",
  "bugs": {
    "url": "https://github.com/stanley2058/hmd/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stanley2058/hmd.git"
  },
  "bin": {
    "hmd": "dist/hmd.js"
  },
  "files": [
    "dist/hmd.js",
    "skills/hmd/SKILL.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "commander": "^14.0.0",
    "diff": "^9.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.14.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0"
}
